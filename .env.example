# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Wise — Settings → API tokens
WISE_API_TOKEN=
WISE_PROFILE_ID=

# Shopify — custom app in store admin (needs read_inventory + read_products scopes)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Google Sheets — GCP service account with the Sheets API enabled,
# shared (Viewer) on the target spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SHEETS_3PL_SPREADSHEET_ID=
SHEETS_3PL_CELL_RANGE=Sheet1!B2

# Used by the dashboard page to call its own API in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
