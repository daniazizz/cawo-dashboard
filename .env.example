# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Wise — Settings → API tokens
WISE_API_TOKEN=
WISE_PROFILE_ID=

# Shopify — Dev Dashboard app, client credentials grant (app + store must be in the same org)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Google Sheets — the sheet must be shared as "anyone with the link can view";
# a plain API key (Sheets API enabled in Google Cloud Console) is enough, no service account needed
GOOGLE_SHEETS_API_KEY=
SHEETS_3PL_SPREADSHEET_ID=
SHEETS_3PL_CELL_RANGE=Sheet1!B2

# Used by the dashboard page to call its own API in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
